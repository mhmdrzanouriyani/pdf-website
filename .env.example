# Copy to .env and fill in what you need. Never commit .env.
# Everything is optional: without these, all browser-side PDF tools still work.

# ---------- AI (server-side only — keys are never sent to the browser) ----------
# Option A: Anthropic Claude
ANTHROPIC_API_KEY=
# Option B: OpenAI or any OpenAI-compatible endpoint (OpenRouter, Groq, Ollama, LM Studio…)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1      # e.g. http://127.0.0.1:11434/v1 for Ollama (no key needed)
# Force a provider (anthropic | openai | none). Auto-detected from the keys above when empty.
# AI_PROVIDER=
# Model name. Default for Anthropic: claude-sonnet-5-5. REQUIRED for the OpenAI-compatible provider.
# AI_MODEL=
# AI_TIMEOUT_MS=90000
# AI_MAX_OUTPUT_TOKENS=2048
# AI_MAX_CONTEXT_CHARS=120000
# AI_RATE_MAX=40                 # requests per IP per window
# AI_RATE_WINDOW_MS=300000

# ---------- Office / HTML → PDF (LibreOffice) ----------
# Auto-detected on PATH and in the default install folders. Set this if it isn't found, e.g.
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# CONVERT_MAX_FILE_MB=25
# CONVERT_TIMEOUT_MS=120000
# CONVERT_CONCURRENCY=2

# ---------- Server ----------
# PORT=8787
# HOST=127.0.0.1
# PUBLIC_URL=http://127.0.0.1:5173          # used in password-reset links
# ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# PDFLY_DATA_DIR=server-data                # accounts are stored here (JSON file)
# SESSION_DAYS=14
# TRUST_PROXY=1                             # set when running behind a reverse proxy

# ---------- Frontend limits (build-time, VITE_ prefix = public, never put secrets here) ----------
# VITE_MAX_FILE_MB=100
# VITE_MAX_SERVER_FILE_MB=25                # keep ≤ CONVERT_MAX_FILE_MB
# VITE_MAX_PAGES=2000
# VITE_MAX_RASTER_PAGES=200
# VITE_MAX_OCR_PAGES=60
# VITE_MAX_STORED_DOCS=25
# VITE_MAX_STORED_MB=600
# VITE_OCR_LANG_PATH=                       # self-hosted Tesseract language data (default: jsDelivr CDN)
# VITE_BILLING_ENABLED=false                # no payment provider is integrated yet
